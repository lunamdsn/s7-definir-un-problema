
candidatos = ["Ana", "Carlos", "Lucía"]

votos = {  "Ana": 0,
    "Carlos": 0,
    "Lucía": 0}

numero_votantes = int(input("¿Cuántas personas van a votar? "))

for i in range(numero_votantes):
    print("\nCandidatos:", candidatos)
    voto = input("Introduce tu voto: ")

    while voto not in candidatos:
        print("Voto no válido.")
        voto = input("Introduce de nuevo tu voto: ")

    votos[voto] += 1

print("\n--- RESULTADOS ---")

for candidato in candidatos:
    print(candidato, ":", votos[candidato], "votos")

max_votos = max(votos.values())

ganadores = []

for candidato in candidatos:
    if votos[candidato] == max_votos:
        ganadores.append(candidato)

if len(ganadores) == 1:
    print("\nEl ganador es", ganadores[0], "con", max_votos, "votos.")
else:
    print("\nHay un empate entre:", ganadores)
    print("Con", max_votos, "votos cada uno.")
