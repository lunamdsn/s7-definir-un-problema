num_candidatos = int(input("Introduce el número de candidatos: "))

votos = {}

for i in range(num_candidatos):
    nombre = input("Introduce el nombre del candidato: ")
    votos[nombre] = 0

num_votantes = int(input("Introduce el número de votantes: "))

for i in range(num_votantes):

    print("Candidatos disponibles:")

    for candidato in votos:
        print("-", candidato)

    voto = input("Introduce tu voto: ")

    while voto not in votos:
        print("Voto no válido.")
        voto = input("Introduce de nuevo tu voto: ")

    votos[voto] += 1

print("\RESULTADOS")

for candidato in votos:
    print(candidato, ":", votos[candidato], "votos")

max_votos = max(votos.values())

ganadores = []

for candidato in votos:
    if votos[candidato] == max_votos:
        ganadores.append(candidato)

if len(ganadores) == 1:
    print("El ganador es:", ganadores[0])
    print("Número de votos:", max_votos)

else:
    print("Hay un empate entre:")

    for candidato in ganadores:
        print("-", candidato)

    print("Con", max_votos, "votos cada uno.")
